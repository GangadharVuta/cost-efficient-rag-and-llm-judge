# RAG Application Configuration
RAG_VECTOR_STORE_TYPE=lancedb  # Options: lancedb, sqlite_vec, chromadb
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2 # Options: all-MiniLM-L6-v2, text-embedding-3-small, local_tfidf
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.35
RAG_DATA_DIR=./data/vector_store

# LLM Provider Configuration
LLM_PROVIDER=offline # Options: openai, gemini, ollama, offline
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_GENERATOR_MODEL=gpt-4o-mini
LLM_JUDGE_MODEL=gpt-4o

# Server & Logging Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
